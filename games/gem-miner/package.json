  "kit": ["audio.js", "lang.js", "langdom.js", "rng.js", "storage.js"],
  "browserModules": [
    "audio.js",
    "input.js",
    "kit/audio.js",
    "kit/langdom.js",
    "main.js",
    "render.js",
    "ui.js"
  ]
}
